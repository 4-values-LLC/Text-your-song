# --- Suno API ---
# API-Key von sunoapi.org (https://sunoapi.org -> API Key Management)
SUNO_API_KEY=

# Endpunkte (Defaults passen für sunoapi.org)
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_UPLOAD_URL=https://sunoapiorg.redpandaai.co/api/file-stream-upload

# Modell: V4 | V4_5 | V4_5PLUS | V4_5ALL | V5 | V5_5
# V5 = neuere Generation (Default), V5_5 = neuestes/höchste Qualität
SUNO_MODEL=V5

# Standard-Gewichte für die Cover-Generierung (0.0 - 1.0)
SUNO_AUDIO_WEIGHT=0.65
SUNO_STYLE_WEIGHT=0.6
SUNO_WEIRDNESS=0.3

# Optionaler Callback (leer => Polling wird verwendet)
SUNO_CALLBACK_URL=

# --- Analyse ---
DEMUCS_ENABLED=true
WHISPER_ENABLED=true
WHISPER_MODEL=base
DEMUCS_MODEL=htdemucs

# --- Infrastruktur ---
WORKSPACE_DIR=./workspace
REDIS_URL=redis://localhost:6379/0
# use_queue=false => Jobs laufen inline via FastAPI BackgroundTasks (kein Redis nötig)
USE_QUEUE=false

# --- Spotify (optional, für Link-Auflösung) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
